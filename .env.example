# Copy to .env and fill in.  (cp .env.example .env)

# Secret for the encrypted PII vault. Generate with:  python cli.py gen-key
# If empty, a dev key is created in storage/.master_key (fine for demos, not for production).
GDPR_RAG_MASTER_KEY=

# offline | anthropic | openai | ollama
LLM_PROVIDER=offline

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Local model, data never leaves your laptop:  ollama pull llama3.1
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

CHUNK_SIZE=900
CHUNK_OVERLAP=120
TOP_K=4
RETENTION_DAYS=90
